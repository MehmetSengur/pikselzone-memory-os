{
  "_comment": "V2.3 reference template. Do NOT hand-merge: run `memory --config <c> register <root> --project <slug>` which fills the placeholders and merges this non-destructively into the repo's .codex/hooks.json.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH={{MEMORY_OS_ROOT}} python3 -m memory_v1.hook_runner --config {{CONFIG_ABS}} --runtime codex --event SessionStart --project {{PROJECT}} --project-root {{PROJECT_ROOT}}",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH={{MEMORY_OS_ROOT}} python3 -m memory_v1.hook_runner --config {{CONFIG_ABS}} --runtime codex --event SessionEnd --project {{PROJECT}} --project-root {{PROJECT_ROOT}}",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH={{MEMORY_OS_ROOT}} python3 -m memory_v1.hook_runner --config {{CONFIG_ABS}} --runtime codex --event PreCompact --project {{PROJECT}} --project-root {{PROJECT_ROOT}}",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH={{MEMORY_OS_ROOT}} python3 -m memory_v1.hook_runner --config {{CONFIG_ABS}} --runtime codex --event Stop --project {{PROJECT}} --project-root {{PROJECT_ROOT}}",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH={{MEMORY_OS_ROOT}} python3 -m memory_v1.hook_runner --config {{CONFIG_ABS}} --runtime codex --event UserPromptSubmit --project {{PROJECT}} --project-root {{PROJECT_ROOT}}",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
