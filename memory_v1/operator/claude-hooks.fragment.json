{
  "_comment": "V2.3 reference template. Do NOT hand-merge: run `memory --config <c> register <root> --project <slug>`, which fills the placeholders and merges this non-destructively into the repo's .claude/settings.local.json.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{MEMORY_OS_ROOT}}/scripts/pz-memory-hook --config {{CONFIG_ABS}} --runtime claude --event SessionStart --project {{PROJECT}} --project-root {{PROJECT_ROOT}}",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{MEMORY_OS_ROOT}}/scripts/pz-memory-hook --config {{CONFIG_ABS}} --runtime claude --event SessionEnd --project {{PROJECT}} --project-root {{PROJECT_ROOT}}",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{MEMORY_OS_ROOT}}/scripts/pz-memory-hook --config {{CONFIG_ABS}} --runtime claude --event PreCompact --project {{PROJECT}} --project-root {{PROJECT_ROOT}}",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{MEMORY_OS_ROOT}}/scripts/pz-memory-hook --config {{CONFIG_ABS}} --runtime claude --event Stop --project {{PROJECT}} --project-root {{PROJECT_ROOT}}",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{MEMORY_OS_ROOT}}/scripts/pz-memory-hook --config {{CONFIG_ABS}} --runtime claude --event UserPromptSubmit --project {{PROJECT}} --project-root {{PROJECT_ROOT}}",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
